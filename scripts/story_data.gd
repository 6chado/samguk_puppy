	]},
	"sp_baima": {"title": "백마 대 원소", "adult": ["gongsun_zan", "yuan_shao"], "pages": [
		{"text": "공손찬 강아지의 흰 말 부대가 달려왔어요.\n다그닥다그닥!", "btn": "멋있어!", "cast": [["gongsun_zan", "line"]]},
